# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# CLOUDFLARE_ACCOUNT_ID & CLOUDFLARE_API_TOKEN: Cloudflare Workers AI credentials for image generation
CLOUDFLARE_ACCOUNT_ID="MY_CLOUDFLARE_ACCOUNT_ID"
CLOUDFLARE_API_TOKEN="MY_CLOUDFLARE_API_TOKEN"

# PREFERRED_IMAGE_ENGINE: 'cloudflare' or 'pollinations'
PREFERRED_IMAGE_ENGINE="cloudflare"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
